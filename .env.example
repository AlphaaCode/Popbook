# Copy to .env and fill in what you use. Every key can also be pasted in the studio instead.
# .env is git-ignored; the studio never writes keys to disk.

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Google Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon

# Any OpenAI-compatible server: Ollama, LM Studio, OpenRouter, Groq, vLLM…
COMPAT_BASE_URL=http://localhost:11434/v1
COMPAT_MODEL=qwen2.5:14b
COMPAT_API_KEY=

# Planner (the outline call) and writer (one call per spread). The studio's preset picks them; these override it. A model id
# from lib/models.js finds its provider (and that provider's key above); otherwise write provider:model.
# PLANNER_MODEL=claude-opus-5-5
# WRITER_MODEL=compat:llama3:8b

# "Claude Code, prompt only": claude -p without tools, on your Claude login. Strong tier (Balanced plans with it, Haiku writes).
# CLAUDE_CLI_MODEL=opus
# CLAUDE_CLI_CMD=claude

# Local coding agents are found on your PATH (claude, codex, gemini). Override the command if needed;
# the prompt is appended as the last argument.
# AGENT_CMD_CLAUDE=claude -p --permission-mode acceptEdits
# AGENT_CMD_CODEX=codex exec --full-auto
# AGENT_CMD_GEMINI=gemini --yolo -p

# Which option the studio selects first (anthropic, openai, gemini, compat, claude-cli, agent-claude, agent-codex, agent-gemini)
# DEFAULT_PROVIDER=agent-claude

# Server. Keep HOST=127.0.0.1 unless you really want other machines on your network to reach the studio.
# PORT=5173
# HOST=127.0.0.1

# Output cap per spread a model call may write (tokens). The default suits every built-in block; raise it if the log says an
# answer "hit the output-token limit".
# SPREAD_MAX_TOKENS=1500

# A model call that sends nothing back for this long (ms) is cut and tried again, like a dropped connection.
# REQUEST_TIMEOUT_MS=90000

# POPBOOK_MOCK=1 adds a "Mock" provider that returns the example book (tests and demos)
# POPBOOK_MOCK=1
